<%
    // 全文搜索页：拉取 search.json 索引，前端过滤展示
    // 需要站点 _config.yml 启用 hexo-generator-search（field: all, content: true）
    // 脚本在 import.ejs 的 <head> 加载（Vue mount 会剥掉 partial 内联脚本）
%>
<div class="search-page">
    <div class="search-bar">
        <input
            id="fulltext-input"
            type="text"
            placeholder="输入关键词，全文搜索（标题 + 正文）"
            autocomplete="off"
        />
    </div>
    <div
        id="fulltext-results"
        class="search-results"
        data-url="<%- url_for('search.json') %>"
    ></div>
</div>

<style>
.search-page {
    max-width: 800px;
    margin: 40px auto 0;
    padding: 0 20px;
}
.search-bar input {
    width: 100%;
    box-sizing: border-box;
    padding: 12px 18px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-surface);
    color: var(--text-primary);
    font-size: 16px;
    outline: none;
    transition: border-color 0.25s, box-shadow 0.25s;
}
.search-bar input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(126, 184, 154, 0.2);
}
.search-results {
    margin-top: 24px;
}
.search-result-item {
    display: block;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px 20px;
    margin-bottom: 14px;
    color: var(--text-primary);
    transition: border-color 0.25s;
}
.search-result-item:hover {
    border-color: var(--accent);
}
.search-result-item .sr-title {
    color: var(--text-heading);
    font-size: 1.1em;
    font-weight: 600;
    margin-bottom: 6px;
}
.search-result-item .sr-meta {
    color: var(--text-secondary);
    font-size: 0.85em;
    margin-bottom: 8px;
}
.search-result-item .sr-snippet {
    font-size: 0.92em;
    line-height: 1.7;
    color: var(--text-primary);
}
.search-result-item .sr-snippet mark {
    background: var(--accent-muted);
    color: var(--on-accent);
    border-radius: 3px;
    padding: 0 2px;
}
.search-empty {
    text-align: center;
    color: var(--text-secondary);
    padding: 40px 0;
}
</style>
